{
  "name": "better-yugioh-card",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "A lightweight Yu-Gi-Oh! card and competitive deck workbench.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "dev:node": "vite-node --watch src/server.js",
    "play": "vite --open /play/index.html",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "build:recognition-index": "node scripts/build-recognition-index.mjs",
    "preview": "vite preview",
    "test": "node --test",
    "test:e2e:setup": "python3 -m pip install --target .runtime/python -r requirements-e2e.txt && PYTHONPATH=.runtime/python python3 -m playwright install chromium",
    "test:e2e": "pnpm test:e2e:workspace && pnpm test:e2e:analysis && pnpm test:e2e:recognition",
    "test:e2e:analysis": "PYTHONPATH=.runtime/python python3 tests/e2e/playtest_analysis_e2e.py",
    "test:e2e:recognition": "PYTHONPATH=.runtime/python python3 tests/e2e/image_recognition_e2e.py && PYTHONPATH=.runtime/python python3 tests/e2e/camera_recognition_e2e.py",
    "test:e2e:workspace": "PYTHONPATH=.runtime/python python3 tests/e2e/workspace_e2e.py",
    "lint": "eslint",
    "lint-fix": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ASTion24/better-yugioh-card.git"
  },
  "homepage": "https://astion24.github.io/better-yugioh-card/",
  "bugs": {
    "url": "https://github.com/ASTion24/better-yugioh-card/issues"
  },
  "keywords": [
    "yugioh-card",
    "yugioh",
    "rush-duel",
    "ygo",
    "leafer",
    "canvas"
  ],
  "author": "ASTion24 and contributors",
  "license": "MIT",
  "dependencies": {
    "@iconify-icons/ri": "^2.0.0",
    "@leafer/node": "^2.0.4",
    "css-line-break": "^2.1.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "leafer": "^2.0.4",
    "leafer-unified": "^1.0.3",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "lodash-unified": "^1.0.3",
    "normalize.css": "^8.0.1",
    "sql.js": "^1.14.2",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.42",
    "yugioh-card": "file:packages",
    "yugioh-card-v190": "npm:yugioh-card@1.9.2"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "sass-embedded": "^1.104.0",
    "skia-canvas": "^3.0.8",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "engines": {
    "node": ">= 22"
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node": "0.16.8",
      "brace-expansion@^1": "1.1.18",
      "brace-expansion@^2": "2.1.4",
      "brace-expansion@^5": "5.0.9",
      "fast-uri": "3.1.6",
      "immutable": "5.1.8",
      "lodash": "4.18.1",
      "nanoid@^3": "3.3.18",
      "picomatch@^2": "2.3.2",
      "picomatch@^4": "4.0.4",
      "postcss": "8.5.28",
      "postcss-selector-parser": "7.1.3"
    },
    "onlyBuiltDependencies": [
      "skia-canvas"
    ]
  }
}
